name: Extraire le projet CAT'Allo

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest

    steps:
      - name: Récupérer le dépôt
        uses: actions/checkout@v4

      - name: Trouver le ZIP
        id: zip
        run: |
          ZIP=$(find . -maxdepth 1 -type f -iname "*.zip" | head -n 1)

          if [ -z "$ZIP" ]; then
            echo "❌ Aucun fichier ZIP trouvé à la racine du dépôt."
            exit 1
          fi

          echo "ZIP trouvé : $ZIP"
          echo "zip=$ZIP" >> "$GITHUB_OUTPUT"

      - name: Extraire le projet
        run: |
          ZIP="${{ steps.zip.outputs.zip }}"

          mkdir -p .catallo_extract
          unzip -o "$ZIP" -d .catallo_extract

          # Si le ZIP contient un dossier racine CATAllo,
          # on récupère directement son contenu.
          if [ -d ".catallo_extract/CATAllo" ]; then
            cp -a .catallo_extract/CATAllo/. .
          else
            cp -a .catallo_extract/. .
          fi

          rm -rf .catallo_extract
          rm -f "$ZIP"

      - name: Configurer Git
        run: |
          git config user.name "CAT'Allo Bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      - name: Enregistrer les fichiers
        run: |
          git add .
          git status --short

          if git diff --cached --quiet; then
            echo "ℹ️ Aucun changement à enregistrer."
          else
            git commit -m "Initialisation du projet CAT'Allo"
            git push
          fi
